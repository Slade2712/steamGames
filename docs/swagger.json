{
    "swagger": "2.0",
    "info": {
        "description": "API REST permettant de consulter les jeux Steam et de gérer les utilisateurs.",
        "title": "Steam Games API",
        "contact": {},
        "version": "1.0"
    },
    "basePath": "/api/v1",
    "paths": {
        "/auth/login": {
            "post": {
                "description": "Authentifie un utilisateur à partir de son adresse e-mail et de son mot de passe.\nEn cas de succès, retourne un token JWT de type Bearer ainsi que sa durée de validité.",
                "consumes": [
                    "application/json"
                ],
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "Auth"
                ],
                "summary": "Se connecter",
                "operationId": "login-user",
                "parameters": [
                    {
                        "description": "Identifiants de connexion",
                        "name": "request",
                        "in": "body",
                        "required": true,
                        "schema": {
                            "$ref": "#/definitions/users.LoginRequest"
                        }
                    }
                ],
                "responses": {
                    "200": {
                        "description": "Authentification réussie",
                        "schema": {
                            "$ref": "#/definitions/users.LoginResponse"
                        }
                    },
                    "400": {
                        "description": "Corps JSON invalide",
                        "schema": {
                            "$ref": "#/definitions/responses.GenericResponse"
                        }
                    },
                    "401": {
                        "description": "Adresse e-mail ou mot de passe incorrect",
                        "schema": {
                            "$ref": "#/definitions/responses.GenericResponse"
                        }
                    },
                    "500": {
                        "description": "Erreur interne lors de l'authentification",
                        "schema": {
                            "$ref": "#/definitions/responses.GenericResponse"
                        }
                    }
                }
            }
        },
        "/auth/register": {
            "post": {
                "description": "Crée un nouveau compte utilisateur à partir d'une adresse e-mail et d'un mot de passe.\nLe mot de passe doit contenir entre 10 et 72 caractères.",
                "consumes": [
                    "application/json"
                ],
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "Auth"
                ],
                "summary": "Créer un compte utilisateur",
                "operationId": "register-user",
                "parameters": [
                    {
                        "description": "Informations nécessaires à la création du compte",
                        "name": "request",
                        "in": "body",
                        "required": true,
                        "schema": {
                            "$ref": "#/definitions/users.RegisterRequest"
                        }
                    }
                ],
                "responses": {
                    "201": {
                        "description": "Compte créé avec succès",
                        "schema": {
                            "$ref": "#/definitions/users.UserResponse"
                        }
                    },
                    "400": {
                        "description": "JSON invalide, adresse e-mail invalide ou mot de passe invalide",
                        "schema": {
                            "$ref": "#/definitions/responses.GenericResponse"
                        }
                    },
                    "409": {
                        "description": "Adresse e-mail déjà utilisée",
                        "schema": {
                            "$ref": "#/definitions/responses.GenericResponse"
                        }
                    },
                    "500": {
                        "description": "Erreur interne lors de la création du compte",
                        "schema": {
                            "$ref": "#/definitions/responses.GenericResponse"
                        }
                    }
                }
            }
        },
        "/games": {
            "get": {
                "description": "Retourne une liste paginée de jeux Steam.\nLes résultats peuvent être filtrés par titre, année de sortie, plateforme et genre.\nLe tri est effectué sur le titre du jeu.\nSi limit est supérieur à 100, sa valeur est automatiquement limitée à 100.",
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "Games"
                ],
                "summary": "Lister les jeux",
                "operationId": "get-games",
                "parameters": [
                    {
                        "type": "integer",
                        "default": 10,
                        "example": 10,
                        "description": "Nombre maximum de jeux retournés",
                        "name": "limit",
                        "in": "query"
                    },
                    {
                        "type": "integer",
                        "default": 0,
                        "example": 0,
                        "description": "Nombre de jeux à ignorer avant de commencer la liste",
                        "name": "skip",
                        "in": "query"
                    },
                    {
                        "enum": [
                            "title",
                            "-title"
                        ],
                        "type": "string",
                        "default": "title",
                        "example": "title",
                        "description": "Ordre de tri par titre",
                        "name": "ordering",
                        "in": "query"
                    },
                    {
                        "type": "string",
                        "example": "Subnautica",
                        "description": "Recherche partielle dans le titre du jeu, insensible à la casse",
                        "name": "title",
                        "in": "query"
                    },
                    {
                        "type": "integer",
                        "example": 2013,
                        "description": "Filtrer les jeux par année de sortie",
                        "name": "release_year",
                        "in": "query"
                    },
                    {
                        "type": "string",
                        "example": "linux",
                        "description": "Filtrer les jeux par nom de plateforme",
                        "name": "platforms",
                        "in": "query"
                    },
                    {
                        "type": "string",
                        "example": "2,25",
                        "description": "Filtrer par un ou plusieurs IDs de genres séparés par des virgules",
                        "name": "genre",
                        "in": "query"
                    }
                ],
                "responses": {
                    "200": {
                        "description": "Liste des jeux récupérée avec succès",
                        "schema": {
                            "$ref": "#/definitions/models.GamesResponse"
                        }
                    },
                    "400": {
                        "description": "Paramètre de requête invalide",
                        "schema": {
                            "$ref": "#/definitions/responses.GenericResponse"
                        }
                    },
                    "500": {
                        "description": "Erreur interne lors de la récupération des jeux",
                        "schema": {
                            "$ref": "#/definitions/responses.GenericResponse"
                        }
                    }
                }
            }
        },
        "/games/{id}": {
            "get": {
                "description": "Retourne toutes les informations disponibles pour un jeu Steam.\nLa réponse contient notamment les développeurs, éditeurs, plateformes, catégories et genres associés au jeu.",
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "Games"
                ],
                "summary": "Récupérer un jeu par son ID",
                "operationId": "get-game-by-id",
                "parameters": [
                    {
                        "type": "integer",
                        "example": 570,
                        "description": "Identifiant Steam du jeu",
                        "name": "id",
                        "in": "path",
                        "required": true
                    }
                ],
                "responses": {
                    "200": {
                        "description": "Jeu récupéré avec succès",
                        "schema": {
                            "$ref": "#/definitions/models.Game"
                        }
                    },
                    "400": {
                        "description": "L'identifiant fourni n'est pas un entier valide",
                        "schema": {
                            "$ref": "#/definitions/responses.GenericResponse"
                        }
                    },
                    "404": {
                        "description": "Aucun jeu correspondant à cet ID",
                        "schema": {
                            "$ref": "#/definitions/responses.GenericResponse"
                        }
                    },
                    "500": {
                        "description": "Erreur interne lors de la récupération du jeu",
                        "schema": {
                            "$ref": "#/definitions/responses.GenericResponse"
                        }
                    }
                }
            }
        },
        "/health": {
            "get": {
                "description": "Vérifie que l'API fonctionne et que la connexion à la base de données PostgreSQL est disponible.\nLa connexion à PostgreSQL est testée avec un délai maximum de 2 secondes.",
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "Health"
                ],
                "summary": "Vérifier l'état de santé de l'API",
                "operationId": "health-check",
                "responses": {
                    "200": {
                        "description": "API opérationnelle et base de données disponible",
                        "schema": {
                            "$ref": "#/definitions/handler.HealthCheckSuccess"
                        }
                    },
                    "503": {
                        "description": "Base de données indisponible",
                        "schema": {
                            "$ref": "#/definitions/handler.HealthCheckUnavailable"
                        }
                    }
                }
            }
        },
        "/users": {
            "get": {
                "security": [
                    {
                        "BearerAuth": []
                    }
                ],
                "description": "Retourne la liste de tous les utilisateurs enregistrés dans l'application.\nLe token doit être envoyé sous la forme : Bearer \u003ctoken\u003e.",
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "Users"
                ],
                "summary": "Lister les utilisateurs",
                "operationId": "get-all-users",
                "responses": {
                    "200": {
                        "description": "Liste des utilisateurs",
                        "schema": {
                            "type": "array",
                            "items": {
                                "$ref": "#/definitions/users.UserResponse"
                            }
                        }
                    },
                    "401": {
                        "description": "Token absent, invalide ou expiré",
                        "schema": {
                            "$ref": "#/definitions/responses.GenericResponse"
                        }
                    },
                    "500": {
                        "description": "Erreur interne lors de la récupération des utilisateurs",
                        "schema": {
                            "$ref": "#/definitions/responses.GenericResponse"
                        }
                    }
                }
            }
        },
        "/users/me": {
            "get": {
                "security": [
                    {
                        "BearerAuth": []
                    }
                ],
                "description": "Retourne les informations de l'utilisateur correspondant au token JWT envoyé dans l'en-tête Authorization.\nLe token doit être envoyé sous la forme : Bearer \u003ctoken\u003e.",
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "Users"
                ],
                "summary": "Récupérer mon profil",
                "operationId": "get-current-user",
                "responses": {
                    "200": {
                        "description": "Utilisateur authentifié",
                        "schema": {
                            "$ref": "#/definitions/users.UserResponse"
                        }
                    },
                    "401": {
                        "description": "Token absent, invalide ou expiré",
                        "schema": {
                            "$ref": "#/definitions/responses.GenericResponse"
                        }
                    }
                }
            }
        }
    },
    "definitions": {
        "handler.HealthCheckSuccess": {
            "type": "object",
            "properties": {
                "database": {
                    "type": "boolean",
                    "example": true
                },
                "message": {
                    "type": "string",
                    "example": "OK"
                }
            }
        },
        "handler.HealthCheckUnavailable": {
            "type": "object",
            "properties": {
                "database": {
                    "type": "boolean",
                    "example": false
                },
                "message": {
                    "type": "string",
                    "example": "Database unavailable"
                }
            }
        },
        "internal_models_games.Category": {
            "type": "object",
            "properties": {
                "description": {
                    "type": "string"
                },
                "id": {
                    "type": "integer"
                }
            }
        },
        "internal_models_games.Genre": {
            "type": "object",
            "properties": {
                "description": {
                    "type": "string"
                },
                "id": {
                    "type": "integer"
                }
            }
        },
        "models.Game": {
            "type": "object",
            "properties": {
                "_id": {
                    "type": "integer"
                },
                "categories": {
                    "type": "array",
                    "items": {
                        "$ref": "#/definitions/internal_models_games.Category"
                    }
                },
                "description": {
                    "type": "string"
                },
                "developers": {
                    "type": "array",
                    "items": {
                        "type": "string"
                    }
                },
                "genres": {
                    "type": "array",
                    "items": {
                        "$ref": "#/definitions/internal_models_games.Genre"
                    }
                },
                "image": {
                    "type": "string"
                },
                "is_free": {
                    "type": "boolean"
                },
                "metacritic_score": {
                    "type": "integer"
                },
                "platforms": {
                    "type": "array",
                    "items": {
                        "type": "string"
                    }
                },
                "price": {
                    "type": "number"
                },
                "publishers": {
                    "type": "array",
                    "items": {
                        "type": "string"
                    }
                },
                "recommendations": {
                    "type": "integer"
                },
                "release_date": {
                    "type": "string"
                },
                "release_year": {
                    "type": "integer"
                },
                "required_age": {
                    "type": "string"
                },
                "title": {
                    "type": "string"
                },
                "website": {
                    "type": "string"
                }
            }
        },
        "models.GamesLinks": {
            "type": "object",
            "properties": {
                "next": {
                    "type": "string"
                },
                "self": {
                    "type": "string"
                }
            }
        },
        "models.GamesResponse": {
            "type": "object",
            "properties": {
                "_links": {
                    "$ref": "#/definitions/models.GamesLinks"
                },
                "items": {
                    "type": "array",
                    "items": {
                        "$ref": "#/definitions/models.Game"
                    }
                },
                "page": {
                    "type": "integer"
                },
                "pageSize": {
                    "type": "integer"
                },
                "totalItems": {
                    "type": "integer"
                },
                "totalPages": {
                    "type": "integer"
                }
            }
        },
        "responses.GenericResponse": {
            "type": "object",
            "properties": {
                "message": {
                    "type": "string",
                    "example": "Invalid request"
                },
                "success": {
                    "type": "boolean",
                    "example": false
                }
            }
        },
        "users.LoginRequest": {
            "type": "object",
            "properties": {
                "email": {
                    "type": "string"
                },
                "password": {
                    "type": "string"
                }
            }
        },
        "users.LoginResponse": {
            "type": "object",
            "properties": {
                "expires_in": {
                    "type": "integer"
                },
                "token": {
                    "type": "string"
                },
                "token_type": {
                    "type": "string"
                }
            }
        },
        "users.RegisterRequest": {
            "type": "object",
            "properties": {
                "email": {
                    "type": "string"
                },
                "password": {
                    "type": "string"
                }
            }
        },
        "users.UserResponse": {
            "type": "object",
            "properties": {
                "created_at": {
                    "type": "string"
                },
                "email": {
                    "type": "string"
                },
                "id": {
                    "type": "integer"
                },
                "role": {
                    "type": "string"
                }
            }
        }
    },
    "securityDefinitions": {
        "BearerAuth": {
            "type": "apiKey",
            "name": "Authorization",
            "in": "header"
        }
    },
    "tags": [
        {
            "description": "Vérification de l'état de santé de l'API.",
            "name": "Health"
        },
        {
            "description": "Inscription et authentification des utilisateurs.",
            "name": "Auth"
        },
        {
            "description": "Gestion des comptes utilisateurs.",
            "name": "Users"
        },
        {
            "description": "Consultation, recherche, filtrage et pagination des jeux Steam.",
            "name": "Games"
        }
    ]
}