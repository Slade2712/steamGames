# API
API_PORT=8080
API_PREFIX=/api/v1/

# DATABASE
DB_HOST=postgres
DB_PORT=5432
DB_SSLMODE=disable

POSTGRES_DB=my_api
POSTGRES_USER=my_api
POSTGRES_PASSWORD=change_me

# Générer avec : openssl rand -hex 32
JWT_SECRET=REPLACE_WITH_A_RANDOM_64_CHARACTER_HEX_SECRET
# CORS
CORS_ALLOWED_ORIGINS=http://localhost:5173
